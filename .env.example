# ===== LLM =====
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_TEMPERATURE=0.1
# 单次回复最大 token 数
LLM_MAX_TOKENS=2048

# ===== AI Service =====
# 逗号分隔的合法 API Key；留空则本地开发模式（不校验）
VALID_API_KEYS=dev-api-key
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8000
# 联网检索开关：true（默认）启动时加载 MCP 联网工具；false 纯本地问答（也可用启动参数 --no-web-search 临时关闭）
ENABLE_WEB_SEARCH=true
# agent 最大工具调研轮次（每轮 = 一次模型思考 + 一次工具执行）；超限返回阶段性回答
MAX_AGENT_TURNS=16

# ===== MCP Gateway =====
# 监听地址：0.0.0.0 表示对外暴露；仅本机访问用 127.0.0.1
MCP_GATEWAY_HOST=0.0.0.0
MCP_GATEWAY_PORT=8001
# AI service 连接 MCP 网关的地址（streamable HTTP）
# 注意：这里是客户端连接地址，不能写 0.0.0.0（Windows 下会连接失败），必须用 127.0.0.1 或 localhost
MCP_GATEWAY_URL=http://127.0.0.1:8001/mcp
